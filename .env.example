# =======================================================
# AptiClash Environment Configuration Template
# =======================================================

# Supabase Backend Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Optional: Supabase Database Direct Password (for psql / migrations)
SUPABASE_DB_PASSWORD=your_database_password_here

# Expo / EAS Cloud Build Token (for CI/CD automated APK/IPA builds)
EXPO_TOKEN=your_expo_access_token_here

# Optional: Google Gemini AI API Key (for real-time LLM chat tutor responses)
# If omitted, Koji AI tutor uses the built-in offline smart heuristic engine
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token (for CLI repository pushes)
GITHUB_PAT=your_github_pat_here
